<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared common inline elements: lb, ptr, ref, label.
  Included by all top-level grobid training schemas.
-->
<grammar xmlns="http://relaxng.org/ns/structure/1.0"
  xmlns:xml="http://www.w3.org/XML/1998/namespace"
  xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"
  ns="http://www.tei-c.org/ns/1.0">

  <define name="lb">
    <element name="lb">
      <empty/>
    </element>
  </define>

  <define name="ptr">
    <element name="ptr">
      <attribute name="target"/>
      <empty/>
    </element>
  </define>

  <define name="ref">
    <element name="ref">
      <a:documentation>
        @subtype and @type are used by encodingDesc/editorialDecl entries
        (human/machine annotation-guide references); unused elsewhere.
      </a:documentation>
      <optional>
        <attribute name="target"/>
      </optional>
      <optional>
        <attribute name="subtype"/>
      </optional>
      <optional>
        <attribute name="type"/>
      </optional>
      <text/>
    </element>
  </define>

  <define name="label">
    <element name="label">
      <a:documentation>Reference number or footnote marker (e.g. [1], &#185;)</a:documentation>
      <optional>
        <attribute name="type"/>
      </optional>
      <text/>
    </element>
  </define>

</grammar>
